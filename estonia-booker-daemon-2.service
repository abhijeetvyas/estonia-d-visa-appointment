[Unit]
Description=Estonia D-Visa Parked-Session Booker Daemon (applicant 2)
After=network.target

[Service]
Type=simple
User=abhijeetvyas13
WorkingDirectory=/home/abhijeetvyas13/estonia-d-visa-appointment
# Same shared secrets file as the first instance (run_booker_daemon_env.sh -
# Telegram/CapSolver credentials are account-level, not per-applicant), but
# with BOOKING_PROFILE and APPLICANT_DATA_REAL overridden AFTER sourcing it,
# so this instance gets its own state/lock/log files (see BOOKING_PROFILE in
# estonia_booker_daemon.py) and books using applicant 2's details instead of
# applicant 1's - completely independent of whatever applicant 1's instance
# has already booked.
ExecStart=/bin/bash -lc 'source /home/abhijeetvyas13/estonia-d-visa-appointment/run_booker_daemon_env.sh && export BOOKING_PROFILE=applicant2 && export APPLICANT_DATA_REAL=/home/abhijeetvyas13/estonia-d-visa-appointment/applicant_data_real_2.json && exec /home/abhijeetvyas13/estonia-d-visa-appointment/venv/bin/python3 /home/abhijeetvyas13/estonia-d-visa-appointment/estonia_booker_daemon.py'
Restart=always
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGTERM

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
