# Matches estonia_visa_monitor.py's own /etc/logrotate.d/estonia-visa-monitor
# config (see AI_CONTEXT.md §3) - daily, 7 rotations, compressed with
# delaycompress, explicit create/su directives (required because these logs
# live in a non-root-owned home directory).
#
# Install with: sudo cp estonia-booker-daemon.logrotate /etc/logrotate.d/estonia-booker-daemon
#
# Glob patterns (not just daemon.log/daemon_polls.csv) so a second,
# BOOKING_PROFILE-suffixed instance's daemon_<profile>.log /
# daemon_polls_<profile>.csv get rotated too, without a second stanza.

/home/abhijeetvyas13/estonia-d-visa-appointment/daemon*.log
/home/abhijeetvyas13/estonia-d-visa-appointment/daemon_polls*.csv {
    daily
    rotate 7
    compress
    delaycompress
    missingok
    notifempty
    create 644 abhijeetvyas13 abhijeetvyas13
    su abhijeetvyas13 abhijeetvyas13
}
